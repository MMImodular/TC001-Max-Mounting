# Auto detect text files and perform LF normalization
* text=auto

# CAD / mesh / print files: never touch line endings or diff
*.f3d   binary
*.f3z   binary
*.step  binary
*.stp   binary
*.iges  binary
*.igs   binary
*.stl   binary
*.3mf   binary
*.obj   binary
*.dxf   binary
*.pdf   binary
*.png   binary
*.jpg   binary
